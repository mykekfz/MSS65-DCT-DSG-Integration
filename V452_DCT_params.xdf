  <XDFCONSTANT uniqueid="0x25" flags="0x0">
    <title>Launch cap min</title>
    <description>Lower limit of the launch cap (above launch rpm).</description>
    <CATEGORYMEM index="0" category="1" />
    <EMBEDDEDDATA mmedtypeflags="0x01" mmedaddress="0x12601E" mmedelementsizebits="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <units>Nm</units>
    <decimalpl>1</decimalpl>
