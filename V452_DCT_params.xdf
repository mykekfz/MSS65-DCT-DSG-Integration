  <XDFCONSTANT uniqueid="0x26" flags="0x0">
    <title>N in P: send offset</title>
    <description>Delay after each DCT 0x1D2 (P) before the DME sends its N frame, in 5 ms steps (20 = 100 ms, middle of the DCT 200 ms cycle). Sent once per DCT frame, retried for 10 steps if the CAN object is busy.</description>
    <CATEGORYMEM index="0" category="1" />
    <EMBEDDEDDATA mmedtypeflags="0x00" mmedaddress="0x12603C" mmedelementsizebits="8" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <units>x 5 ms</units>
    <decimalpl>0</decimalpl>
    <datatype>0</datatype>
    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="X">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
